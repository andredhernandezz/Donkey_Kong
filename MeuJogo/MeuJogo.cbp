<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="MeuJogo" />
		<Option pch_mode="2" />
		<Option compiler="mingw_novo" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/MeuJogo" prefix_auto="1" extension_auto="1" />
